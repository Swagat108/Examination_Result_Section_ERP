# Copy to .env and fill in. Never commit .env.

# MySQL 8.0 (relational data)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=university_erp

# MongoDB (notifications, activity logs, student documents, resumes)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=university_erp

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Backend
PORT=4000
