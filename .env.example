# Copy to .env (repo root or backend/) and fill in. Never commit .env.

# ---------------------------------------------------------------
# Database: Supabase (PLACEHOLDERS - the team will fill these in)
# ---------------------------------------------------------------
# Project URL and keys: Supabase dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (for running the db/ scripts): Project Settings > Database
DATABASE_URL=

# ---------------------------------------------------------------
# Legacy local MySQL 8.0 (used by db/rebuild.sh|ps1 until the Supabase migration)
# ---------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=university_erp

# MongoDB (notifications, activity logs, student documents, resumes)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=university_erp

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Backend
PORT=4000
CORS_ORIGIN=http://localhost:5173
